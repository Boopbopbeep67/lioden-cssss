/* FONTS - Import from Google Fonts */
 
@import url('https://fonts.googleapis.com/css2?family=Libre+Caslon+Condensed:ital,wght@0,400;0,700;1,400;1,700&display=swap');
 
body {font-family: 'Libre Caslon Condensed', serif;}
 
.topbar {font-family: 'Libre Caslon Condensed', serif;}
 
.navbar {font-family: 'Libre Caslon Condensed', serif;}

/* BACKGROUNDS 
The first one is for PC, the second is for mobile. You can also use an image in the second one
via replacing #HEX with url('IMG LINK') center center fixed;
BUT I recommend repeating patterns rather than full images. */

@media screen and (min-width: 601px) { body {
background: url('<img src="https://i.ibb.co/23KyZ8Fb/albany-damask-classic-ivory-wallpaper-0-lg.webp" alt="albany damask classic ivory wallpaper 0 lg" border="0">') center center fixed; background-size: cover;
color: #E6BE8A; }}

@media screen and (max-width: 600px) {
    body {
        background: url('<img src="https://i.ibb.co/23KyZ8Fb/albany-damask-classic-ivory-wallpaper-0-lg.webp" alt="albany damask classic ivory wallpaper 0 lg" border="0">') center center;
background-size: cover; }}
